[ext_resource type="PackedScene" uid="uid://dp847uerg8cbe" path="res://Ui/health_bar_ui.tscn" id="1_c2t11"]

[sub_resource type="GDScript" id="GDScript_repyr"]
script/source = "class_name HealthComponent extends Node

@export var player : CharacterBody3D
@export var max_health : float = 100.0
@export var collition_shape : CollisionShape3D
@onready var health_bar_ui: HealthBarUi = $HealthBarUi

var current_health : float = 0.0
var is_death : bool = false


func _ready() -> void:
	current_health = max_health


func _process(_delta:float):
	current_health = clamp(current_health, 0.0, max_health)

func take_damage(amount: float):
	current_health -= amount
	
	if health_bar_ui:
		health_bar_ui.update_health(current_health,max_health)
	
	if current_health <= 0.0:
		is_death = true
		player.queue_free()

func take_healing(amount : float):
	current_health += amount
	
	if health_bar_ui:
		health_bar_ui.update_health(current_health,max_health)
"

